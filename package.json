{
  "name": "@wisteria30/delegate-claude",
  "version": "2.8.3",
  "description": "MCP server for delegating work to Claude Code with asynchronous sessions and explicit permission control",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "delegate-claude": "dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:stdio:cancel": "node scripts/e2e/stdio-cancel-regression.mjs --mode fast-cancel --iterations 20",
    "e2e:stdio:cancel:wp": "node scripts/e2e/stdio-cancel-regression.mjs --mode waiting-permission-cancel --iterations 20",
    "e2e:stdio:interrupt": "node scripts/e2e/stdio-cancel-regression.mjs --mode fast-interrupt --iterations 20",
    "e2e:stdio:interrupt:wp": "node scripts/e2e/stdio-cancel-regression.mjs --mode waiting-permission-interrupt --iterations 20",
    "e2e:stdio:reply-race": "node scripts/e2e/stdio-reply-race-regression.mjs",
    "e2e:stdio:runner": "node scripts/e2e/stdio-runner.mjs --iterations 20",
    "prepublishOnly": "task build",
    "lint": "eslint src/ tests/",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "claude-code",
    "claude",
    "claude-agent-sdk",
    "anthropic",
    "agent",
    "coding-agent",
    "model-context-protocol",
    "ai"
  ],
  "author": "Wisteria30",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wisteria30/delegate-claude.git"
  },
  "homepage": "https://github.com/Wisteria30/delegate-claude#readme",
  "bugs": {
    "url": "https://github.com/Wisteria30/delegate-claude/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "skills",
    "LICENSE",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "NOTICE.md",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@anthropic-ai/sdk": "^0.115.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
